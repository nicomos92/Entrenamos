# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase
# (Project Settings > API en el dashboard de Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo se usa en el servidor (server actions) para crear usuarios de alumnos.
# NUNCA exponer esta key al cliente ni commitear el .env.local real.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
